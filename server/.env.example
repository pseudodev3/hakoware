# Railway API service
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret

# Railway MongoDB service.
# Suggested service name: MongoDB
MONGO_URI=${{MongoDB.MONGO_URL}}

# Vercel frontend origin used for password-reset links and CORS.
FRONTEND_URL=https://hakoware.vercel.app
CORS_ORIGINS=https://hakoware.vercel.app

# Railway Storage Bucket for private voice notes.
# Suggested bucket name: VoiceNotes
BUCKET=${{VoiceNotes.BUCKET}}
ENDPOINT=${{VoiceNotes.ENDPOINT}}
ACCESS_KEY_ID=${{VoiceNotes.ACCESS_KEY_ID}}
SECRET_ACCESS_KEY=${{VoiceNotes.SECRET_ACCESS_KEY}}
REGION=${{VoiceNotes.REGION}}
BUCKET_URL_STYLE=virtual

# Brevo transactional email over HTTPS API.
# Generate this under Brevo -> SMTP & API -> API Keys.
# Do not use the SMTP key here.
BREVO_API_KEY=your-brevo-api-key
# EMAIL_FROM must use a sender verified in Brevo.
EMAIL_FROM="Hakoware <hakoware265@gmail.com>"
# Optional address for replies from users.
EMAIL_REPLY_TO=hakoware265@gmail.com
# Public Railway API URL. Railway also injects RAILWAY_PUBLIC_DOMAIN automatically.
# Set this only if you use a custom API URL.
# PUBLIC_API_URL=https://your-api.up.railway.app

# Optional override for the transactional-email logo.
# By default Hakoware serves the canonical logo directly from its Railway API.
# EMAIL_LOGO_URL=https://your-api.up.railway.app/brand/hakoware-mark-v2.jpg

# Founder Test Lab allowlist. Comma-separate multiple founder emails if needed.
FOUNDER_EMAILS=hakoware265@gmail.com
