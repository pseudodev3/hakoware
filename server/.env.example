# Required
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/hakoware
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=https://hakoware.vercel.app

# Optional: comma-separated. If omitted, the API accepts browser origins from any domain.
CORS_ORIGINS=https://hakoware.vercel.app

# Email / Brevo SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Hakoware <hakoware265@gmail.com>"

# Railway Volume mount path for persistent voice-note storage.
# If you mount the volume at /data, use /data here.
UPLOAD_DIR=/data
