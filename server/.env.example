# Hakoware VPS API service
NODE_ENV=production
PORT=5001
TRUST_PROXY_HOPS=1
# Use at least 32 random characters. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret

# MongoDB connection (Docker Compose internal network by default).
MONGO_URI=mongodb://mongo:27017/hakoware

# Vercel frontend origin used for password-reset links and CORS.
FRONTEND_URL=https://hakoware.xyz
CORS_ORIGINS=https://hakoware.xyz,https://www.hakoware.xyz,https://hakoware.vercel.app

# Private media storage for voice notes, avatars and Sparks photos.
# Set BUCKET + ENDPOINT + ACCESS_KEY_ID + SECRET_ACCESS_KEY to use Cloudflare R2 / Backblaze B2 / AWS S3,
# or leave them blank with LOCAL_STORAGE_DIR=/data/media to store media on the persistent VPS volume.
LOCAL_STORAGE_DIR=/data/media
BUCKET=
ENDPOINT=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=auto
BUCKET_URL_STYLE=path

# Brevo transactional email over HTTPS API.
# Generate this under Brevo -> SMTP & API -> API Keys.
# Do not use the SMTP key here.
BREVO_API_KEY=your-brevo-api-key
# EMAIL_FROM must use a sender verified in Brevo.
EMAIL_FROM="Hakoware <hakoware265@gmail.com>"
# Optional address for replies from users.
EMAIL_REPLY_TO=hakoware265@gmail.com
# Public VPS API URL used for email brand assets and payment webhook callbacks.
PUBLIC_API_URL=https://api.hakoware.xyz

# Cloudflare Tunnel token (optional; used by the `cloudflared` service for https://api.hakoware.xyz).
TUNNEL_TOKEN=

# Optional override for the transactional-email logo.
# By default Hakoware serves the canonical logo directly from PUBLIC_API_URL.
# EMAIL_LOGO_URL_V2=https://api.hakoware.xyz/brand/hakoware-mark-v2.jpg

# Background debt refresh. The API still refreshes debt on normal requests as a fallback.
DEBT_WORKER_ENABLED=true
# Minimum accepted value is 60000 (1 minute). Default is 300000 (5 minutes).
DEBT_WORKER_INTERVAL_MS=300000

# Background Chaos refresh. Only due production Chaos contracts are queried.
CHAOS_WORKER_ENABLED=true
# Default is 60000 (1 minute). Minimum accepted value is 30000 (30 seconds).
CHAOS_WORKER_INTERVAL_MS=60000

# Delete abandoned staged voice uploads from private storage.
VOICE_CLEANUP_ENABLED=true
# Default is 600000 (10 minutes). Minimum accepted value is 60000.
VOICE_CLEANUP_INTERVAL_MS=600000

# Founder Test Lab allowlist. Comma-separate multiple founder emails if needed.
FOUNDER_EMAILS=hakoware265@gmail.com

# Cosmetic checkout. Keep sales closed until wallet, keys, prices and delivery are verified.
COSMETIC_SALES_ENABLED=false
COSMETIC_PAYMENT_PROVIDER=nowpayments
NOWPAYMENTS_API_KEY=
# The raw IPN secret is required locally for HMAC verification; keep it server-only.
NOWPAYMENTS_IPN_SECRET=
# Sandbox is for non-production environments only. Switch keys and mode together.
NOWPAYMENTS_SANDBOX=false
# Public API origin for payment callbacks (also supports the existing API_URL fallback).
# PUBLIC_API_URL=https://api.hakoware.xyz
COSMETIC_PRICE_CURRENCY=usd
# Major-unit USD prices. Launch suggestion: 4.99 per edition, 11.99 for the set.
# Enter approved prices here; blank values keep sales closed.
COSMETIC_PRICE_NOCTURNE=
COSMETIC_PRICE_PRISM=
COSMETIC_PRICE_PORCELAIN=
COSMETIC_PRICE_COMPLETE=
# Previous Stripe orders remain recoverable. Select stripe explicitly for new Stripe orders.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_NOCTURNE=
STRIPE_PRICE_PRISM=
STRIPE_PRICE_PORCELAIN=
STRIPE_PRICE_COMPLETE=
# Enable only after configuring Stripe Tax for the merchant account.
STRIPE_AUTOMATIC_TAX_ENABLED=false
