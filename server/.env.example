# Railway API service
NODE_ENV=production
PORT=5001
JWT_SECRET=replace-with-a-long-random-secret

# Reference the Railway MongoDB service.
# Suggested service name: MongoDB
MONGO_URI=${{MongoDB.MONGO_URL}}

# Reference the Railway frontend service.
# Suggested service name: Frontend
FRONTEND_URL=https://${{Frontend.RAILWAY_PUBLIC_DOMAIN}}
CORS_ORIGINS=https://${{Frontend.RAILWAY_PUBLIC_DOMAIN}}

# Railway Storage Bucket for private voice notes.
# Suggested bucket name: VoiceNotes
BUCKET=${{VoiceNotes.BUCKET}}
ENDPOINT=${{VoiceNotes.ENDPOINT}}
ACCESS_KEY_ID=${{VoiceNotes.ACCESS_KEY_ID}}
SECRET_ACCESS_KEY=${{VoiceNotes.SECRET_ACCESS_KEY}}
REGION=${{VoiceNotes.REGION}}
# Use path only if the bucket credentials panel explicitly says path-style URLs.
BUCKET_URL_STYLE=virtual

# Email / Brevo SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Hakoware <no-reply@example.com>"
