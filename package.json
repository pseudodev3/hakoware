{
  "name": "hakoware-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/seo/renderPublic.jsx --outDir node_modules/.cache/hakoware-ssr --emptyOutDir && node scripts/prerenderPublic.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:circle-activity": "node scripts/checkCircleActivity.mjs",
    "check:next-move": "node scripts/checkNextMove.mjs",
    "check:bank-retry": "node scripts/checkBankRetry.mjs",
    "check:seo": "node scripts/checkSeo.mjs",
    "check:checkout-links": "node scripts/checkCheckoutLinks.mjs",
    "check:ui-polish": "node scripts/checkUiPolish.mjs",
    "check:duel-feedback": "node scripts/checkDuelFeedback.mjs",
    "check:game-sounds": "node --test scripts/checkGameSounds.mjs",
    "check:session-boundaries": "node --test scripts/checkSessionBoundaries.mjs"
  },
  "dependencies": {
    "framer-motion": "12.35.0",
    "lucide-react": "0.577.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "9.9.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.9.0",
    "eslint-plugin-react-hooks": "5.1.0-rc.0",
    "eslint-plugin-react-refresh": "0.4.9",
    "globals": "15.9.0",
    "vite": "6.4.4"
  }
}
